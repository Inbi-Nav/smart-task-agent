{
    "name": "smart-task-agent/app",
    "type": "project",
    "require": {
        "vlucas/phpdotenv": "^5.8",
        "guzzlehttp/guzzle": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": ["app/helpers.php"]
